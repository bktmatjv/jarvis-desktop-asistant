# ==========================================
# CONFIGURACIÓN DE MODELOS Y SERVICIOS GROQ
# ==========================================

# 1. Reconocimiento de Voz (STT - Groq Whisper)
GROQ_API_KEYS_VOICE=gsk_your_voice_key_here
VOICE_MODEL=whisper-large-v3-turbo

# 2. Enrutador Rápido y Chat Conversacional
GROQ_API_KEYS_FAST=gsk_your_fast_key_here
ROUTER_MODEL=openai/gpt-oss-20b
FAST_MODEL=openai/gpt-oss-20b

# 3. Razonamiento Complejo y Tool Calling (admite múltiples claves separadas por coma para rotación)
GROQ_API_KEYS_REASONING=gsk_reasoning_key_1,gsk_reasoning_key_2
REASONING_MODEL=qwen/qwen3.6-27b

# Claves de Respaldo / Fallback Global
GROQ_API_KEYS=gsk_fallback_key_1,gsk_fallback_key_2
GROQ_API_KEY=gsk_fallback_key_1
STALLING_ENABLED=True

# ==========================================
# BASE DE DATOS Y SERVICIOS EXTERNOS
# ==========================================
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
TAVILY_API_KEY=tvly-your_tavily_key

# ==========================================
# CLIENTE Y PERSONALIZACIÓN
# ==========================================
BACKEND_URL=ws://127.0.0.1:8000/ws
USER_NAME=MATIAS JAVIER
USER_ROLE=admin
